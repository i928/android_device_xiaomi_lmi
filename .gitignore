# Private key of ksu_manager_cert: local only, never pushed (the old one
# leaked through this repo and was rotated 2026-10-02).
security/ksu_manager/*.pk8
# KernelSU module zips etc.: local content; only make-snapshot.sh is tracked.
ksu-autoinstall/*
!ksu-autoinstall/snapshot/
ksu-autoinstall/snapshot/*
!ksu-autoinstall/snapshot/make-snapshot.sh
# Generated by ~/extraAPKs (run.sh/publish.sh): hardlinked app set, not tracked.
extra-apps/
